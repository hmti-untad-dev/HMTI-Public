# Secret untuk Payload (wajib, ganti di production)
PAYLOAD_SECRET=ganti-dengan-string-acak-panjang

# Kosongkan / "file:./hmti.db" untuk SQLite lokal.
# Isi "postgres://user:pass@host:5432/hmti" untuk Postgres (production).
DATABASE_URI=file:./hmti.db

# URL publik situs (SEO, OG, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin pertama untuk `npm run seed` (hanya dev/test; ganti & jangan dipakai di production)
SEED_ADMIN_EMAIL=admin@hmti.test
SEED_ADMIN_PASSWORD=ganti-saat-seed
